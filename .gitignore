# Runtime assets fetched at page load, not source.
node_modules/

# Datasets are regenerated by scripts/make-data.sh (multi-GB; never committed).
data/

# duckdb-wasm binaries (~32 MB) and the pglite/sqlite wasm payloads. Copied in
# by scripts/fetch-vendor.sh so the repo stays small.
public/vendor/

# Self-signed certs for local https (generated by scripts/serve.sh --lan).
certs/

# Browser/OS noise
.DS_Store
*.log
playwright-report/
test-results/
